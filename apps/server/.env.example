# MySQL 8 connection
DATABASE_URL=mysql://spendapp:change-me@127.0.0.1:3306/spendapp
PORT=3000
# Set to 1 behind HTTPS (enables the __Host- session cookie). Leave 0 for local dev.
COOKIE_SECURE=0

# Where receipt images are stored
RECEIPTS_DIR=./data/receipts

# The privacy policy shown at registration. Kept out of the repository: it is
# deployment text and may name people. While this file is missing the app
# serves privacy.example.md, says so on the signup form, and never asks
# existing accounts to re-consent.
PRIVACY_PATH=./data/privacy.md

# Public origin of the app (used for OAuth redirect URIs)
APP_ORIGIN=http://localhost:5173

# Every proxy between a client and the API, innermost first. See deploy/README.md.
TRUSTED_PROXIES=loopback

# Keys the fake KDF salt handed out for usernames that do not exist. Without a
# secret value the decoys can be recomputed offline and /api/auth/params tells
# an attacker which accounts are real. Required in production — the server
# refuses to start without it. Generate with: openssl rand -hex 32
#AUTH_DECOY_SECRET=

# Web push — generate once with: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
