[Unit]
Description=SpendApp API
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=spendapp
Group=spendapp
WorkingDirectory=__APP_DIR__/current/apps/server
ExecStart=__APP_DIR__/current/apps/server/node_modules/.bin/tsx src/index.ts
Environment=NODE_ENV=production
Restart=always
RestartSec=2

# The app listens on 127.0.0.1 and only ever writes to the shared state dir.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=__APP_DIR__/shared

# Nothing here needs a capability: the app binds 3000, not a privileged port.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Receipts and .env are written 0600/0700 rather than left group-readable.
UMask=0077
# MemoryDenyWriteExecute is deliberately absent: V8 maps executable pages for
# the JIT and would be killed on the first compile.

[Install]
WantedBy=multi-user.target
